From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 17 Oct 2026 04:56:21 +0000
Subject: [PATCH 08/24] SettingsLib: use day/night /e/ colours in the v36
 resources

Android 17 resolves SettingsLib colours from the -v36 folders, which shadow the
-v31/-v34 files that 'SettingsLib: Theme according to our palette' themes.
Mirror its dialog and spinner colours there, using the day/night e_* aliases
instead of the light-only variants (values-night-v36 keeps its dark ones).
---
 .../SettingsLib/SettingsTheme/res/values-v36/colors.xml   | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/packages/SettingsLib/SettingsTheme/res/values-v36/colors.xml b/packages/SettingsLib/SettingsTheme/res/values-v36/colors.xml
index d28a2e28e44f..34386bd2d4f5 100644
--- a/packages/SettingsLib/SettingsTheme/res/values-v36/colors.xml
+++ b/packages/SettingsLib/SettingsTheme/res/values-v36/colors.xml
@@ -38,10 +38,10 @@
     <color name="settingslib_track_off_color">@color/settingslib_materialColorSurfaceContainerHighest</color>
 
     <!-- Dialog text button color. -->
-    <color name="settingslib_dialog_accent">@*android:color/e_accent_light</color>
+    <color name="settingslib_dialog_accent">@*android:color/e_accent</color>
 
     <!-- Dialog background color. -->
-    <color name="settingslib_dialog_background">@*android:color/e_floating_background_light</color>
+    <color name="settingslib_dialog_background">@*android:color/e_floating_background</color>
 
     <!-- Material next track outline color-->
     <color name="settingslib_track_online_color">@color/settingslib_switch_track_outline_color</color>
@@ -51,7 +51,7 @@
     <color name="settingslib_text_color_preference_category_title">@color/settingslib_materialColorPrimary</color>
 
     <!-- The text color of spinner title -->
-    <color name="settingslib_spinner_title_color">@*android:color/e_primary_text_color_light</color>
+    <color name="settingslib_spinner_title_color">@*android:color/e_primary_text_color</color>
     <!-- The text color of dropdown item title -->
-    <color name="settingslib_spinner_dropdown_color">@*android:color/e_primary_text_color_light</color>
+    <color name="settingslib_spinner_dropdown_color">@*android:color/e_primary_text_color</color>
 </resources>
\ No newline at end of file
