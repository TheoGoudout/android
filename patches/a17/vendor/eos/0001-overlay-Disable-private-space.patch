+<!--
+    /e/OS: no private space. Disabling the user type stops new private profiles from being
+    created (UserManager.canAddPrivateProfile() returns false, so Settings hides the entry);
+    see frameworks/base/core/res/res/xml/config_user_types.xml for the format.
+-->
+<user-types>
+    <profile-type
+        name="android.os.usertype.profile.PRIVATE"
+        enabled="0" />
+</user-types>
