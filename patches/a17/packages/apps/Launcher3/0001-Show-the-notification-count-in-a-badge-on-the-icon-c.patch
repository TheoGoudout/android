+package com.android.launcher3.dot;
+
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.graphics.Typeface;
+
+/**
+ * Draws the number of notifications in a pill, in the place of the notification dot, for the
+ * icons of the apps and the folders.
+ */
+public class CountBadge {
+
+    private static final float SIZE_FACTOR = 0.28f;
+    private static final float TEXT_SIZE_FACTOR = 0.64f;
+    private static final float PADDING_FACTOR = 0.3f;
+    private static final int COLOR = 0xFF01D066;
+    private static final int TEXT_COLOR = Color.WHITE;
+
+    private final RectF mBounds = new RectF();
+    private final Paint mPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint mTextPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+
+    public CountBadge() {
+        mPaint.setColor(COLOR);
+        mTextPaint.setColor(TEXT_COLOR);
+        mTextPaint.setTypeface(Typeface.create(Typeface.DEFAULT, Typeface.BOLD));
+        mTextPaint.setTextAlign(Paint.Align.CENTER);
+    }
+
+    /**
+     * Draws the badge. The round end of the pill is centered on the corner of the icon, and the
+     * pill gets longer over the icon.
+     *
+     * @param cornerX  the x of the top corner of the square outline of the icon
+     * @param cornerY  the y of the top corners of the square outline of the icon
+     * @param iconSize the size of the icon, which sets the size of the badge
+     * @param isLeft   whether the corner is the top left one, so the pill gets longer to the right
+     * @param scale    the scale of the badge, which grows from the corner when it appears
+     */
+    public void draw(Canvas canvas, int count, float cornerX, float cornerY, float iconSize,
+            boolean isLeft, float scale) {
+        if (scale <= 0 || count <= 0) {
+            return;
+        }
+        float height = SIZE_FACTOR * iconSize;
+        mTextPaint.setTextSize(height * TEXT_SIZE_FACTOR);
+        String text = format(count);
+        float width = Math.max(height, mTextPaint.measureText(text) + 2 * height * PADDING_FACTOR);
+
+        float halfHeight = height / 2;
+        if (isLeft) {
+            mBounds.set(cornerX - halfHeight, cornerY - halfHeight,
+                    cornerX - halfHeight + width, cornerY + halfHeight);
+        } else {
+            mBounds.set(cornerX + halfHeight - width, cornerY - halfHeight,
+                    cornerX + halfHeight, cornerY + halfHeight);
+        }
+
+        canvas.save();
+        canvas.scale(scale, scale, cornerX, cornerY);
+        canvas.drawRoundRect(mBounds, halfHeight, halfHeight, mPaint);
+        Paint.FontMetrics fm = mTextPaint.getFontMetrics();
+        canvas.drawText(text, mBounds.centerX(),
+                mBounds.centerY() - (fm.ascent + fm.descent) / 2, mTextPaint);
+        canvas.restore();
+    }
+
+    /** Returns the count as is below 1000, and like 1.5k from 1000. */
+    private static String format(int count) {
+        if (count < 1000) {
+            return Integer.toString(count);
+        }
+        // Rounded down, so that 9999 is 9.9k and not 10k
+        int tenths = count / 100;
+        return tenths % 10 == 0 ? (tenths / 10) + "k" : (tenths / 10) + "." + (tenths % 10) + "k";
+    }
+}
