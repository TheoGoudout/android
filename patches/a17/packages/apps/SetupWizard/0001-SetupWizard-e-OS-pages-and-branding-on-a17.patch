+
+class EAccountManagerActivity : SubBaseActivity() {
+
+    private var signInButton: View? = null
+    private var createAccountButton: View? = null
+    private var loggedInMessage: TextView? = null
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        if (LOGV) {
+            logActivityState("onCreate savedInstanceState=$savedInstanceState")
+        }
+        setNextAllowed(true)
+        setNextText(R.string.skip)
+
+        signInButton = findViewById(R.id.sign_in)
+        createAccountButton = findViewById(R.id.create_account)
+        loggedInMessage = findViewById(R.id.e_account_logged_in_message)
+    }
+
+    override fun onResume() {
+        super.onResume()
+        updateUiForAccountState()
+    }
+
+    override fun onStartSubactivity() {
+        findViewById<View>(R.id.sign_in).setOnClickListener { launchAccountManagerSetup() }
+        findViewById<View>(R.id.create_account).setOnClickListener {
+            startSubactivity(Intent(ACTION_CREATE_E_ACCOUNT))
+        }
+    }
+
+    override fun onSubactivityResult(activityResult: ActivityResult) {
+        val data = activityResult.data
+        if (data?.getBooleanExtra("onBackPressed", false) == true) {
+            onStartSubactivity()
+            updateUiForAccountState()
+            // Check for back press from AccountManager activity
+        } else if (EAccountUtils.isEAccountAvailable(this)) {
+            Log.v(TAG, "An E account is already set up; skipping EAccountManagerActivity")
+            nextAction(RESULT_OK)
+        }
+    }
+
+    private fun updateUiForAccountState() {
+        val isLoggedIn = EAccountUtils.isEAccountAvailable(this)
+
+        signInButton?.visibility = if (isLoggedIn) View.GONE else View.VISIBLE
+        createAccountButton?.visibility = if (isLoggedIn) View.GONE else View.VISIBLE
+        loggedInMessage?.let {
+            if (isLoggedIn) {
+                val eAccount = EAccountUtils.getFirstEAccount(this)
+                if (eAccount != null && !TextUtils.isEmpty(eAccount.name)) {
+                    it.text =
+                        getString(R.string.e_account_manager_logged_in_with_name, eAccount.name)
+                } else {
+                    it.setText(R.string.e_account_manager_logged_in)
+                }
+                it.visibility = View.VISIBLE
+            } else {
+                it.visibility = View.GONE
+            }
+        }
+
+        setNextAllowed(true)
+        setNextText(if (isLoggedIn) R.string.next else R.string.skip)
+    }
+
+    private fun launchAccountManagerSetup() {
+        startSubactivity(
+            Intent(Settings.ACTION_ADD_ACCOUNT)
+                .putExtra(Settings.EXTRA_ACCOUNT_TYPES, arrayOf(ACCOUNT_TYPE_E))
+        )
+    }
+
+    override val layoutResId = R.layout.setup_e_account_manager
+
+    override val titleResId = R.string.e_account_manager_setup_title
+
+    override val iconResId = R.drawable.ic_account_manager_screen
+
+    companion object {
+        private const val TAG = "EAccountManagerActivity"
+    }
+}
