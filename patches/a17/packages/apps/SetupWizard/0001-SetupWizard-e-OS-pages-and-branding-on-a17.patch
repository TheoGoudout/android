+import org.lineageos.setupwizard.base.SubBaseActivity
+import org.lineageos.setupwizard.util.SetupWizardUtils
+
+class FindMyDeviceActivity : SubBaseActivity() {
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+
+        if (isSkipped()) {
+            nextAction(RESULT_SKIP)
+            return
+        }
+
+        if (!SetupWizardUtils.hasTelephony(this)) {
+            Log.v(TAG, "Has no telephony support")
+            hasTelephonySupport = false
+            onNextPressed()
+            return
+        }
+
+        setNextAllowed(true)
+        setNextText(R.string.skip)
+    }
+
+    override fun isSkipped() = SetupWizardUtils.isFmdRestoreFinished(this)
+
+    override fun onRestart() {
+        super.onRestart()
+
+        if (!hasTelephonySupport) {
+            onNextPressed()
+        }
+    }
+
+    override fun onStartSubactivity() {
+        findViewById<View>(R.id.activate_find_my_device).setOnClickListener {
+            Log.v(TAG, "launch find my device")
+            launchFindMyDevice()
+        }
+    }
+
+    override fun onSubactivityResult(activityResult: ActivityResult) {
+        val data = activityResult.data
+        // Check for back press
+        if (data?.getBooleanExtra("onBackPressed", false) == true) {
+            onStartSubactivity()
+        } else if (activityResult.resultCode == RESULT_OK) {
+            onNextPressed()
+        }
+    }
+
+    private fun launchFindMyDevice() {
+        startSubactivity(
+            Intent()
+                .setComponent(
+                    ComponentName(
+                        "foundation.e.findmydevice",
+                        "foundation.e.findmydevice.activity.FindMyDeviceActivity",
+                    )
+                )
+        )
+    }
+
+    override val layoutResId = R.layout.setup_find_my_device
+
+    override val titleResId = R.string.find_my_device_setup_title
+
+    override val iconResId = R.drawable.ic_find_my_device
+
+    companion object {
+        private const val TAG = "FindMyDeviceActivity"
+
+        private var hasTelephonySupport = true
+    }
+}
