+import android.content.Intent
+import android.content.IntentSender
+import android.content.pm.PackageInstaller
+import android.util.Log
+import java.io.File
+import java.io.FileInputStream
+
+object AppInstaller {
+
+    private const val TAG = "AppInstaller"
+
+    const val ACTION_INSTALL_COMPLETE = "INSTALL_COMPLETE"
+    const val PACKAGE_NAME = "PACKAGE_NAME"
+
+    private const val COPY_BUFFER_SIZE = 65536
+
+    /** @return null on success; otherwise an error message. */
+    fun silentInstallApplication(context: Context, file: File): String? = runCatching {
+        val packageManager = context.packageManager
+        val packageInfo =
+            packageManager.getPackageArchiveInfo(file.path, 0)
+                ?: error("Failed to parse the admin app package")
+
+        val packageName = packageInfo.packageName
+        Log.i(TAG, "Installing $packageName")
+
+        val packageInstaller = packageManager.packageInstaller
+        val params =
+            PackageInstaller.SessionParams(PackageInstaller.SessionParams.MODE_FULL_INSTALL).apply {
+                setAppPackageName(packageName)
+            }
+        val sessionId = packageInstaller.createSession(params)
+        packageInstaller.openSession(sessionId).use { session ->
+            FileInputStream(file).use { input ->
+                session.openWrite("COSU", 0, -1).use { output ->
+                    input.copyTo(output, COPY_BUFFER_SIZE)
+                    session.fsync(output)
+                }
+            }
+            session.commit(createIntentSender(context, sessionId, packageName))
+        }
+        Log.i(TAG, "Installation session committed")
+        null
+    }
+        .getOrElse {
+            Log.w(TAG, "PackageInstaller error: ${it.message}", it)
+            it.message
+        }
+
+    private fun createIntentSender(
+        context: Context,
+        sessionId: Int,
+        packageName: String?,
+    ): IntentSender {
+        val intent =
+            Intent(ACTION_INSTALL_COMPLETE).apply {
+                packageName?.let { putExtra(PACKAGE_NAME, it) }
+            }
+        return PendingIntent.getBroadcast(
+                context,
+                sessionId,
+                intent,
+                PendingIntent.FLAG_MUTABLE or PendingIntent.FLAG_ALLOW_UNSAFE_IMPLICIT_INTENT,
+            )
+            .intentSender
+    }
+
+    fun getPackageInstallerStatusMessage(status: Int) =
+        when (status) {
+            PackageInstaller.STATUS_PENDING_USER_ACTION -> "PENDING_USER_ACTION"
+            PackageInstaller.STATUS_SUCCESS -> "SUCCESS"
+            PackageInstaller.STATUS_FAILURE -> "FAILURE_UNKNOWN"
+            PackageInstaller.STATUS_FAILURE_BLOCKED -> "BLOCKED"
+            PackageInstaller.STATUS_FAILURE_ABORTED -> "ABORTED"
+            PackageInstaller.STATUS_FAILURE_INVALID -> "INVALID"
+            PackageInstaller.STATUS_FAILURE_CONFLICT -> "CONFLICT"
+            PackageInstaller.STATUS_FAILURE_STORAGE -> "STORAGE"
+            PackageInstaller.STATUS_FAILURE_INCOMPATIBLE -> "INCOMPATIBLE"
+            else -> "UNKNOWN"
+        }
+}
diff --git a/app/src/main/java/org/lineageos/setupwizard/mdm/MdmInstallActivity.kt b/app/src/main/java/org/lineageos/setupwizard/mdm/MdmInstallActivity.kt
new file mode 100644
index 0000000..8f3769d
--- /dev/null
+++ b/app/src/main/java/org/lineageos/setupwizard/mdm/MdmInstallActivity.kt
@@ -0,0 +1,250 @@
+/*
+ * SPDX-FileCopyrightText: 2016 The CyanogenMod Project
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.setupwizard.mdm
+
+import android.app.admin.DevicePolicyManager
+import android.app.admin.DevicePolicyManager.EXTRA_PROVISIONING_ADMIN_EXTRAS_BUNDLE
+import android.app.admin.DevicePolicyManager.EXTRA_PROVISIONING_DEVICE_ADMIN_COMPONENT_NAME
+import android.app.admin.DevicePolicyManager.EXTRA_PROVISIONING_DEVICE_ADMIN_PACKAGE_CHECKSUM
+import android.app.admin.DevicePolicyManager.EXTRA_PROVISIONING_DEVICE_ADMIN_SIGNATURE_CHECKSUM
+import android.app.admin.DevicePolicyManager.EXTRA_PROVISIONING_LEAVE_ALL_SYSTEM_APPS_ENABLED
+import android.app.admin.DevicePolicyManager.EXTRA_PROVISIONING_LOCALE
+import android.app.admin.DevicePolicyManager.EXTRA_PROVISIONING_SKIP_ENCRYPTION
+import android.content.BroadcastReceiver
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.content.pm.PackageInstaller
+import android.content.pm.PackageManager
+import android.os.Bundle
+import android.os.Looper
+import android.view.View
+import android.widget.ProgressBar
+import android.widget.TextView
+import androidx.appcompat.app.AlertDialog
+import java.io.File
+import java.util.Locale
+import java.util.concurrent.Executors
+import org.lineageos.setupwizard.R
+import org.lineageos.setupwizard.SetupWizardApp
+import org.lineageos.setupwizard.base.BaseSetupWizardActivity
+
+class MdmInstallActivity :
+    BaseSetupWizardActivity(), ProvisioningQrParser.ErrorHandler, AppDownloader.Handler {
+
+    private lateinit var spinner: ProgressBar
+    private lateinit var message: TextView
+    private lateinit var linearProgress: ProgressBar
+    private lateinit var progressLegend: TextView
+
+    private var qrContents: ProvisioningQrParser.Data? = null
+
+    private val executor = Executors.newSingleThreadExecutor()
+    private val ui = android.os.Handler(Looper.getMainLooper())
+
+    private val appInstallReceiver =
+        object : BroadcastReceiver() {
+            override fun onReceive(context: Context, intent: Intent) {
+                when (val status = intent.getIntExtra(PackageInstaller.EXTRA_STATUS, 0)) {
+                    PackageInstaller.STATUS_SUCCESS -> handleInstallComplete()
+                    // Installation failure
+                    else ->
+                        handleInstallError(
+                            AppInstaller.getPackageInstallerStatusMessage(status),
+                            intent.getStringExtra(PackageInstaller.EXTRA_STATUS_MESSAGE),
+                        )
+                }
+            }
+        }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        setNextAllowed(false)
+        bindViews()
+
+        val qrRawContents = intent.getStringExtra(EXTRA_QR_CONTENTS)
+        qrContents = ProvisioningQrParser(this).parseProvisioningQr(this, qrRawContents)
+        qrContents?.let {
+            it.locale?.let { locale ->
+                (application as SetupWizardApp).ignoreSimLocale = true
+                com.android.internal.app.LocalePicker.updateLocale(
+                    Locale.forLanguageTag(locale.replace('_', '-'))
+                )
+            }
+            message.text = getString(R.string.downloading_admin_app)
+            AppDownloader(this).downloadApp(this, it)
+        }
+    }
+
+    private fun bindViews() {
+        spinner = requireViewById(R.id.spinning_progress)
+        message = requireViewById(R.id.text_message)
+        linearProgress = requireViewById(R.id.linear_progress)
+        progressLegend = requireViewById(R.id.progress_legend)
+    }
+
+    override fun handleDownloadStart(lengthOfFile: Int) {
+        message.text = getString(R.string.downloading_admin_app)
+        if (lengthOfFile == -1) {
+            // We don't know the content length
+            spinner.visibility = View.VISIBLE
+            linearProgress.visibility = View.GONE
+            progressLegend.visibility = View.GONE
+        } else {
+            spinner.visibility = View.GONE
+            linearProgress.visibility = View.VISIBLE
+            progressLegend.visibility = View.VISIBLE
+            handleDownloadProgress(0, lengthOfFile)
+        }
+    }
+
+    override fun handleDownloadProgress(progress: Int, lengthOfFile: Int) {
+        if (lengthOfFile != -1) {
+            val downloadedMb = progress / BYTES_IN_MB
+            val totalMb = lengthOfFile / BYTES_IN_MB
+            progressLegend.text = getString(R.string.download_progress, downloadedMb, totalMb)
+            linearProgress.progress = (downloadedMb * 100 / totalMb).toInt()
+        }
+    }
+
+    override fun handleDownloadComplete(file: File) {
+        // Installing the admin app
+        spinner.visibility = View.VISIBLE
+        message.text = getString(R.string.installing_admin_app)
+        registerReceiver(
+            appInstallReceiver,
+            IntentFilter(AppInstaller.ACTION_INSTALL_COMPLETE),
+            Context.RECEIVER_EXPORTED,
+        )
+        executor.execute {
+            val error = AppInstaller.silentInstallApplication(this, file)
+            if (error != null) {
+                unregisterInstallReceiver()
+                ui.post { handleError(getString(R.string.install_failed) + error) }
+            }
+            // Install completion is caught in the BroadcastReceiver
+        }
+    }
+
+    override fun handleError(message: String) {
+        unregisterInstallReceiver()
+
+        AlertDialog.Builder(this)
+            .setTitle(R.string.error_title)
+            .setMessage(message)
+            .setPositiveButton(R.string.button_ok) { dialog, _ ->
+                dialog.dismiss()
+                finishAction(RESULT_CANCELED, Intent().putExtra("onBackPressed", true))
+            }
+            .setCancelable(false)
+            .create()
+            .show()
+    }
+
+    private fun handleInstallComplete() {
+        spinner.visibility = View.GONE
+        message.text = getString(R.string.install_successful)
+        setNextAllowed(true)
+    }
+
+    private fun handleInstallError(statusMessage: String, extraMessage: String?) {
+        var errorText = getString(R.string.install_failed) + statusMessage
+        if (!extraMessage.isNullOrEmpty()) {
+            errorText += ", extra: $extraMessage"
+        }
+        handleError(errorText)
+    }
+
+    /** The receiver may not be registered, or may already have been unregistered. */
+    private fun unregisterInstallReceiver() {
+        runCatching { unregisterReceiver(appInstallReceiver) }
+    }
+
+    override fun onNextPressed() {
+        unregisterInstallReceiver()
+        startProvisioning()
+    }
+
+    private fun startProvisioning() {
+        if (!packageManager.hasSystemFeature(PackageManager.FEATURE_DEVICE_ADMIN)) {
+            handleError(
+                getString(
+                    R.string.provision_failed_no_feature,
+                    PackageManager.FEATURE_DEVICE_ADMIN,
+                )
+            )
+            return
+        }
+
+        val dpm = getSystemService(DevicePolicyManager::class.java)
+        if (dpm == null) {
+            handleError(
+                getString(R.string.provision_failed_no_feature, Context.DEVICE_POLICY_SERVICE)
+            )
+            return
+        }
+
+        if (!dpm.isProvisioningAllowed(DevicePolicyManager.ACTION_PROVISION_MANAGED_DEVICE)) {
+            handleError(getString(R.string.provision_failed_not_allowed))
+            return
+        }
+
+        val qrContents = qrContents ?: return
+
+        val adminComponentName =
+            qrContents.adminComponentName
+                ?: run {
+                    handleError(getString(R.string.component_name_is_null))
+                    return
+                }
+
+        val adminComponentNameParts = adminComponentName.split("/")
+        if (adminComponentNameParts.size != 2) {
+            handleError(getString(R.string.component_name_wrong_format) + adminComponentName)
+            return
+        }
+
+        val intent =
+            Intent(this, ProvisionActivity::class.java).apply {
+                putExtra(
+                    EXTRA_PROVISIONING_DEVICE_ADMIN_COMPONENT_NAME,
+                    ComponentName(adminComponentNameParts[0], adminComponentNameParts[1]),
+                )
+                qrContents.packageChecksum?.let {
+                    putExtra(EXTRA_PROVISIONING_DEVICE_ADMIN_PACKAGE_CHECKSUM, it)
+                }
+                qrContents.signatureChecksum?.let {
+                    putExtra(EXTRA_PROVISIONING_DEVICE_ADMIN_SIGNATURE_CHECKSUM, it)
+                }
+                if (qrContents.systemAppsEnabled) {
+                    putExtra(EXTRA_PROVISIONING_LEAVE_ALL_SYSTEM_APPS_ENABLED, true)
+                }
+                if (qrContents.skipEncryption) {
+                    putExtra(EXTRA_PROVISIONING_SKIP_ENCRYPTION, true)
+                }
+                qrContents.extrasBundle?.let {
+                    putExtra(EXTRA_PROVISIONING_ADMIN_EXTRAS_BUNDLE, it)
+                }
+                qrContents.locale?.let { putExtra(EXTRA_PROVISIONING_LOCALE, it) }
+            }
+
+        startActivity(intent)
+    }
+
+    override val layoutResId = R.layout.mdm_install_page
+
+    override val titleResId = R.string.provisioning_title
+
+    override val iconResId = R.drawable.ic_mdm
+
+    companion object {
+        const val EXTRA_QR_CONTENTS = "EXTRA_QR_CONTENTS"
+
+        private const val BYTES_IN_MB = 1048576.0f
+    }
+}
