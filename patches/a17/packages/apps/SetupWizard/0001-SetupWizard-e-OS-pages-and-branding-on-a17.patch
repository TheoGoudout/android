--- /dev/null
+++ b/app/src/main/java/org/lineageos/setupwizard/mdm/ApkSignatureCalculator.kt
@@ -0,0 +1,38 @@
+package org.lineageos.setupwizard.mdm
+
+import android.content.Context
+import android.content.pm.PackageManager
+import android.util.Base64
+import java.io.File
+import java.security.MessageDigest
+
+object ApkSignatureCalculator {
+
+    /** Returns SHA-256 checksum(s) of the signing certificate(s) of an APK file. */
+    fun getSignatureChecksums(context: Context, apkFile: File): List<String> {
+        val apkPath = apkFile.absolutePath
+        val packageInfo =
+            context.packageManager.getPackageArchiveInfo(
+                apkPath,
+                PackageManager.GET_SIGNING_CERTIFICATES,
+            ) ?: throw IllegalStateException("Failed to parse APK: $apkPath")
+
+        val signatures =
+            packageInfo.signingInfo?.let {
+                // If multiple signers exist, use APK contents signers; otherwise use the
+                // signing certificate history.
+                if (it.hasMultipleSigners()) it.apkContentsSigners else it.signingCertificateHistory
+            } ?: packageInfo.signatures
+
+        if (signatures.isNullOrEmpty()) {
+            throw IllegalStateException("No signatures found in APK: $apkPath")
+        }
+
+        return signatures.map {
+            Base64.encodeToString(
+                MessageDigest.getInstance("SHA-256").digest(it.toByteArray()),
+                Base64.NO_WRAP or Base64.URL_SAFE,
+            )
+        }
+    }
+}
diff --git a/app/src/main/java/org/lineageos/setupwizard/mdm/AppDownloader.kt b/app/src/main/java/org/lineageos/setupwizard/mdm/AppDownloader.kt
new file mode 100644
index 0000000..17cca8a
--- /dev/null
+++ b/app/src/main/java/org/lineageos/setupwizard/mdm/AppDownloader.kt
@@ -0,0 +1,167 @@
+package org.lineageos.setupwizard.mdm
+
+import android.app.Activity
+import android.os.Looper
+import android.util.Base64
+import java.io.DataInputStream
+import java.io.File
+import java.io.FileOutputStream
+import java.net.HttpURLConnection
+import java.net.URL
+import java.security.MessageDigest
+import java.util.concurrent.Executors
+import org.lineageos.setupwizard.R
+
+class AppDownloader(private val handler: Handler) {
+
+    interface Handler {
+        fun handleDownloadStart(lengthOfFile: Int)
+
+        fun handleDownloadProgress(progress: Int, lengthOfFile: Int)
+
+        fun handleDownloadComplete(file: File)
+
+        fun handleError(message: String)
+    }
+
+    private val executor = Executors.newSingleThreadExecutor()
+    private val ui = android.os.Handler(Looper.getMainLooper())
+
+    private var file: File? = null
+    private var calculatedPackageChecksum: String? = null
+    private var calculatedSignatureChecksums: List<String>? = null
+
+    fun downloadApp(context: Activity, qrContents: ProvisioningQrParser.Data) {
+        executor.execute {
+            if (!downloadAdminAppSync(context, qrContents)) {
+                return@execute
+            }
+            if (
+                qrContents.packageChecksum != null &&
+                    !checksumsEqual(qrContents.packageChecksum, calculatedPackageChecksum)
+            ) {
+                notifyError(context.getString(R.string.checksum_failed))
+                return@execute
+            }
+
+            if (qrContents.signatureChecksum != null) {
+                // calculatedSignatureChecksums shouldn't be null here: if the signature
+                // checksums fail to be calculated an exception is raised. Check anyway.
+                val match =
+                    calculatedSignatureChecksums?.any {
+                        checksumsEqual(qrContents.signatureChecksum, it)
+                    } ?: false
+                if (!match) {
+                    notifyError(context.getString(R.string.checksum_failed))
+                    return@execute
+                }
+            }
+
+            // packageChecksum and signatureChecksum can't both be null,
+            // this is checked in ProvisioningQrParser
+
+            notifyDownloadComplete(file!!)
+        }
+    }
+
+    /** Checksums may differ in padding (extra `=` signs). */
+    private fun checksumsEqual(first: String?, second: String?) =
+        first != null &&
+            second != null &&
+            first.replace("=", "").equals(second.replace("=", ""), true)
+
+    private fun downloadAdminAppSync(
+        context: Activity,
+        qrContents: ProvisioningQrParser.Data,
+    ): Boolean {
+        val file = File(context.filesDir, ADMIN_APK_FILE_NAME).also { this.file = it }
+        if (file.exists()) {
+            file.delete()
+        }
+
+        runCatching { file.createNewFile() }
+            .onFailure {
+                it.printStackTrace()
+                notifyError("Failed to create ${file.absolutePath}")
+                return false
+            }
+
+        runCatching {
+            val connection =
+                (URL(qrContents.downloadLocation).openConnection() as HttpURLConnection).apply {
+                    requestMethod = "GET"
+                    setRequestProperty("Accept-Encoding", "identity")
+                    connectTimeout = CONNECTION_TIMEOUT_MS
+                    readTimeout = CONNECTION_TIMEOUT_MS
+                    connect()
+                }
+
+            check(connection.responseCode == HttpURLConnection.HTTP_OK) {
+                "Bad server response for ${qrContents.downloadLocation}: " +
+                    "${connection.responseCode}"
+            }
+
+            val lengthOfFile = connection.contentLength
+            notifyDownloadStart(lengthOfFile)
+
+            val digest = MessageDigest.getInstance("SHA-256")
+            var total = 0L
+
+            DataInputStream(connection.inputStream).use { input ->
+                FileOutputStream(file).use { output ->
+                    val buffer = ByteArray(1024)
+                    while (true) {
+                        val length = input.read(buffer)
+                        if (length <= 0) {
+                            break
+                        }
+                        digest.update(buffer, 0, length)
+                        total += length
+                        notifyDownloadProgress(total.toInt(), lengthOfFile)
+                        output.write(buffer, 0, length)
+                    }
+                    output.flush()
+                }
+            }
+
+            if (qrContents.packageChecksum != null) {
+                calculatedPackageChecksum =
+                    Base64.encodeToString(digest.digest(), Base64.NO_WRAP or Base64.URL_SAFE)
+            }
+
+            if (qrContents.signatureChecksum != null) {
+                calculatedSignatureChecksums =
+                    ApkSignatureCalculator.getSignatureChecksums(context, file)
+            }
+        }
+            .onFailure {
+                it.printStackTrace()
+                file.delete()
+                notifyError(context.getString(R.string.download_failed) + it.message)
+                return false
+            }
+
+        return true
+    }
+
+    private fun notifyDownloadStart(lengthOfFile: Int) {
+        ui.post { handler.handleDownloadStart(lengthOfFile) }
+    }
+
+    private fun notifyDownloadProgress(progress: Int, lengthOfFile: Int) {
+        ui.post { handler.handleDownloadProgress(progress, lengthOfFile) }
+    }
+
+    private fun notifyDownloadComplete(file: File) {
+        ui.post { handler.handleDownloadComplete(file) }
+    }
+
+    private fun notifyError(message: String) {
+        ui.post { handler.handleError(message) }
+    }
+
+    companion object {
+        private const val CONNECTION_TIMEOUT_MS = 10_000
+        private const val ADMIN_APK_FILE_NAME = "deviceadmin.apk"
+    }
+}
