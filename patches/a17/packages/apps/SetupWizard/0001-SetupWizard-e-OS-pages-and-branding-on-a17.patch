+/*
+ * SPDX-FileCopyrightText: 2016 The CyanogenMod Project
+ * SPDX-FileCopyrightText: The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.setupwizard.mdm
+
+import androidx.activity.result.ActivityResult
+import com.google.android.setupcompat.util.ResultCodes.RESULT_ACTIVITY_NOT_FOUND
+import org.lineageos.setupwizard.network.NetworkSetupActivity
+
+class MdmNetworkSetupActivity : NetworkSetupActivity() {
+
+    override fun onSubactivityResult(activityResult: ActivityResult) {
+        val resultCode = activityResult.resultCode
+        val data = activityResult.data
+        when {
+            // We should proxy the QR code contents to the MDM install activity,
+            // so sending intent here
+            resultCode != RESULT_CANCELED -> nextAction(resultCode, intent)
+            isSubactivityNotFound -> finishAction(RESULT_ACTIVITY_NOT_FOUND)
+            data?.getBooleanExtra("onBackPressed", false) == true -> onStartSubactivity()
+            else -> finishAction(RESULT_CANCELED)
+        }
+    }
+}
diff --git a/app/src/main/java/org/lineageos/setupwizard/mdm/ProvisionActivity.kt b/app/src/main/java/org/lineageos/setupwizard/mdm/ProvisionActivity.kt
new file mode 100644
index 0000000..859152a
--- /dev/null
+++ b/app/src/main/java/org/lineageos/setupwizard/mdm/ProvisionActivity.kt
@@ -0,0 +1,212 @@
+package org.lineageos.setupwizard.mdm
+
+import android.app.Activity
+import android.app.admin.DevicePolicyManager
+import android.content.ComponentName
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.os.Bundle
+import android.os.PersistableBundle
+import android.provider.Settings
+import android.util.Log
+import androidx.appcompat.app.AlertDialog
+import org.lineageos.setupwizard.R
+import org.lineageos.setupwizard.util.SetupWizardUtils
+
+class ProvisionActivity : Activity() {
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        provisionDeviceOwner()
+    }
+
+    private fun provisionDeviceOwner() {
+        val qrIntent = intent
+        val provisionIntent =
+            Intent(ACTION_PROVISION_MANAGED_DEVICE_FROM_TRUSTED_SOURCE).apply {
+                putExtra(EXTRA_PROVISIONING_TRIGGER, PROVISIONING_TRIGGER_QR_CODE)
+
+                putExtra(
+                    DevicePolicyManager.EXTRA_PROVISIONING_DEVICE_ADMIN_COMPONENT_NAME,
+                    qrIntent.getParcelableExtra<ComponentName>(
+                        DevicePolicyManager.EXTRA_PROVISIONING_DEVICE_ADMIN_COMPONENT_NAME
+                    ),
+                )
+
+                putExtra(
+                    DevicePolicyManager.EXTRA_PROVISIONING_DEVICE_ADMIN_SIGNATURE_CHECKSUM,
+                    qrIntent.getStringExtra(
+                        DevicePolicyManager.EXTRA_PROVISIONING_DEVICE_ADMIN_SIGNATURE_CHECKSUM
+                    ),
+                )
+
+                if (
+                    qrIntent.getBooleanExtra(
+                        DevicePolicyManager.EXTRA_PROVISIONING_LEAVE_ALL_SYSTEM_APPS_ENABLED,
+                        false,
+                    )
+                ) {
+                    putExtra(
+                        DevicePolicyManager.EXTRA_PROVISIONING_LEAVE_ALL_SYSTEM_APPS_ENABLED,
+                        true,
+                    )
+                }
+
+                if (
+                    qrIntent.getBooleanExtra(
+                        DevicePolicyManager.EXTRA_PROVISIONING_SKIP_ENCRYPTION,
+                        false,
+                    )
+                ) {
+                    putExtra(DevicePolicyManager.EXTRA_PROVISIONING_SKIP_ENCRYPTION, true)
+                }
+
+                qrIntent.getStringExtra(DevicePolicyManager.EXTRA_PROVISIONING_LOCALE)?.let {
+                    putExtra(DevicePolicyManager.EXTRA_PROVISIONING_LOCALE, it)
+                }
+
+                qrIntent
+                    .getParcelableExtra<PersistableBundle>(
+                        DevicePolicyManager.EXTRA_PROVISIONING_ADMIN_EXTRAS_BUNDLE
+                    )
+                    ?.let {
+                        putExtra(DevicePolicyManager.EXTRA_PROVISIONING_ADMIN_EXTRAS_BUNDLE, it)
+                    }
+            }
+
+        startActivityForResult(provisionIntent, REQUEST_CODE_STEP1)
+    }
+
+    private fun disableSelfAndFinish() {
+        // Remove this activity from the package manager.
+        val name = packageName
+        Log.i(TAG, "Disabling itself ($name)")
+        packageManager.setApplicationEnabledSetting(
+            name,
+            PackageManager.COMPONENT_ENABLED_STATE_DISABLED,
+            PackageManager.DONT_KILL_APP,
+        )
+
+        // Terminate the wizard.
+        SetupWizardUtils.finishSetupWizard(this)
+    }
+
+    private fun handleProvisioningStep1Result(resultCode: Int) {
+        val requestCodeStep2 =
+            when (resultCode) {
+                RESULT_CODE_PROFILE_OWNER_SET -> REQUEST_CODE_STEP2_PO
+                RESULT_CODE_DEVICE_OWNER_SET -> REQUEST_CODE_STEP2_DO
+                else -> {
+                    factoryReset(
+                        "invalid response from the provisioning engine: " +
+                            resultCodeToString(resultCode)
+                    )
+                    return
+                }
+            }
+
+        val intent = Intent(PROVISION_FINALIZATION_INSIDE_SUW).addCategory(Intent.CATEGORY_DEFAULT)
+
+        Log.i(TAG, "Finalizing DPC with $intent")
+
+        startActivityForResult(intent, requestCodeStep2)
+    }
+
+    private fun handleProvisioningStep2Result(requestCode: Int, resultCode: Int) {
+        // Must set state before launching the intent that finalizes the DPC, because the DPC
+        // implementation might not remove the back button
+        setProvisioningState()
+
+        if (resultCode != RESULT_OK) {
+            factoryReset(
+                getString(R.string.invalid_engine_response) + resultCodeToString(resultCode)
+            )
+            return
+        }
+
+        val doMode = requestCode == REQUEST_CODE_STEP2_DO
+        Log.i(TAG, "${if (doMode) "Device owner" else "Profile owner"} mode provisioned!")
+
+        SetupWizardUtils.finishSetupWizard(this)
+    }
+
+    private fun setProvisioningState() {
+        // Add a persistent setting to allow other apps to know the device has been provisioned.
+        Settings.Global.putInt(contentResolver, Settings.Global.DEVICE_PROVISIONED, 1)
+        Settings.Secure.putInt(contentResolver, Settings.Secure.USER_SETUP_COMPLETE, 1)
+    }
+
+    override fun onActivityResult(requestCode: Int, resultCode: Int, data: Intent?) {
+        Log.d(
+            TAG,
+            "onActivityResult(): request=$requestCode, " +
+                "result=${resultCodeToString(resultCode)}, data=$data",
+        )
+
+        when (requestCode) {
+            REQUEST_CODE_STEP1 -> handleProvisioningStep1Result(resultCode)
+            REQUEST_CODE_STEP2_PO,
+            REQUEST_CODE_STEP2_DO -> handleProvisioningStep2Result(requestCode, resultCode)
+            else -> Log.e(TAG, "Error: onActivityResult(): invalid request code $requestCode")
+        }
+    }
+
+    private fun factoryReset(reason: String) {
+        AlertDialog.Builder(this)
+            .setMessage(getString(R.string.provision_failed_need_reset, reason))
+            .setPositiveButton(getString(R.string.button_reset)) { _, _ ->
+                sendFactoryResetIntent(reason)
+            }
+            .setOnDismissListener { sendFactoryResetIntent(reason) }
+            .show()
+    }
+
+    private fun sendFactoryResetIntent(reason: String) {
+        Log.e(TAG, "Factory resetting: $reason")
+        sendBroadcast(
+            Intent(Intent.ACTION_FACTORY_RESET).apply {
+                setPackage("android")
+                addFlags(Intent.FLAG_RECEIVER_FOREGROUND)
+                putExtra(Intent.EXTRA_REASON, reason)
+            }
+        )
+
+        // Just in case the factory reset request fails...
+        setProvisioningState()
+        disableSelfAndFinish()
+    }
+
+    private fun resultCodeToString(resultCode: Int): String {
+        val name =
+            when (resultCode) {
+                RESULT_OK -> "RESULT_OK"
+                RESULT_CANCELED -> "RESULT_CANCELED"
+                RESULT_FIRST_USER -> "RESULT_FIRST_USER"
+                RESULT_CODE_PROFILE_OWNER_SET -> "RESULT_CODE_PROFILE_OWNER_SET"
+                RESULT_CODE_DEVICE_OWNER_SET -> "RESULT_CODE_DEVICE_OWNER_SET"
+                else -> "UNKNOWN_CODE"
+            }
+        return "$name($resultCode)"
+    }
+
+    companion object {
+        private const val TAG = "ProvisionActivity"
+
+        private const val PROVISIONING_TRIGGER_QR_CODE = 2
+
+        // Copied from the ManagedProvisioning app, as they're hidden
+        private const val PROVISION_FINALIZATION_INSIDE_SUW =
+            "android.app.action.PROVISION_FINALIZATION_INSIDE_SUW"
+        private const val RESULT_CODE_PROFILE_OWNER_SET = 122
+        private const val RESULT_CODE_DEVICE_OWNER_SET = 123
+
+        // Copied from DevicePolicyManager internal code
+        private const val ACTION_PROVISION_MANAGED_DEVICE_FROM_TRUSTED_SOURCE =
+            "android.app.action.PROVISION_MANAGED_DEVICE_FROM_TRUSTED_SOURCE"
+        private const val EXTRA_PROVISIONING_TRIGGER = "android.app.extra.PROVISIONING_TRIGGER"
+
+        const val REQUEST_CODE_STEP1 = 42
+        const val REQUEST_CODE_STEP2_PO = 43
+        const val REQUEST_CODE_STEP2_DO = 44
+    }
+}
diff --git a/app/src/main/java/org/lineageos/setupwizard/mdm/ProvisioningQrParser.kt b/app/src/main/java/org/lineageos/setupwizard/mdm/ProvisioningQrParser.kt
new file mode 100644
index 0000000..d7d4ac8
--- /dev/null
+++ b/app/src/main/java/org/lineageos/setupwizard/mdm/ProvisioningQrParser.kt
@@ -0,0 +1,123 @@
+package org.lineageos.setupwizard.mdm
+
+import android.app.admin.DevicePolicyManager.EXTRA_PROVISIONING_ADMIN_EXTRAS_BUNDLE
+import android.app.admin.DevicePolicyManager.EXTRA_PROVISIONING_DEVICE_ADMIN_COMPONENT_NAME
+import android.app.admin.DevicePolicyManager.EXTRA_PROVISIONING_DEVICE_ADMIN_PACKAGE_CHECKSUM
+import android.app.admin.DevicePolicyManager.EXTRA_PROVISIONING_DEVICE_ADMIN_PACKAGE_DOWNLOAD_LOCATION
+import android.app.admin.DevicePolicyManager.EXTRA_PROVISIONING_DEVICE_ADMIN_SIGNATURE_CHECKSUM
+import android.app.admin.DevicePolicyManager.EXTRA_PROVISIONING_LEAVE_ALL_SYSTEM_APPS_ENABLED
+import android.app.admin.DevicePolicyManager.EXTRA_PROVISIONING_LOCALE
+import android.app.admin.DevicePolicyManager.EXTRA_PROVISIONING_SKIP_ENCRYPTION
+import android.content.Context
+import android.os.PersistableBundle
+import org.json.JSONArray
+import org.json.JSONObject
+import org.lineageos.setupwizard.R
+
+class ProvisioningQrParser(private val errorHandler: ErrorHandler) {
+
+    fun interface ErrorHandler {
+        fun handleError(message: String)
+    }
+
+    class Data {
+        var adminComponentName: String? = null
+        var downloadLocation: String? = null
+        var packageChecksum: String? = null
+        var signatureChecksum: String? = null
+        var skipEncryption = false
+        var systemAppsEnabled = false
+        var extrasBundle: PersistableBundle? = null
+        var locale: String? = null
+    }
+
+    fun parseProvisioningQr(context: Context, qrContent: String?): Data? {
+        val jsonNode = runCatching {
+            JSONObject(qrContent ?: "")
+        }
+            .getOrElse {
+                errorHandler.handleError(context.getString(R.string.qr_parse_failed))
+                return null
+            }
+
+        val data = Data()
+
+        data.adminComponentName =
+            jsonNode.textOrNull(EXTRA_PROVISIONING_DEVICE_ADMIN_COMPONENT_NAME)
+                ?: run {
+                    errorHandler.handleError(
+                        context.getString(R.string.qr_missing_parameter) +
+                            EXTRA_PROVISIONING_DEVICE_ADMIN_COMPONENT_NAME
+                    )
+                    return null
+                }
+
+        data.downloadLocation =
+            jsonNode.textOrNull(EXTRA_PROVISIONING_DEVICE_ADMIN_PACKAGE_DOWNLOAD_LOCATION)
+                ?: run {
+                    errorHandler.handleError(
+                        context.getString(R.string.qr_missing_parameter) +
+                            EXTRA_PROVISIONING_DEVICE_ADMIN_PACKAGE_DOWNLOAD_LOCATION
+                    )
+                    return null
+                }
+
+        data.packageChecksum = jsonNode.textOrNull(EXTRA_PROVISIONING_DEVICE_ADMIN_PACKAGE_CHECKSUM)
+        if (data.packageChecksum == null) {
+            // Fallback: signature checksum
+            data.signatureChecksum =
+                jsonNode.textOrNull(EXTRA_PROVISIONING_DEVICE_ADMIN_SIGNATURE_CHECKSUM)
+                    ?: run {
+                        errorHandler.handleError(
+                            context.getString(R.string.qr_missing_parameter) +
+                                EXTRA_PROVISIONING_DEVICE_ADMIN_PACKAGE_CHECKSUM +
+                                " / " +
+                                EXTRA_PROVISIONING_DEVICE_ADMIN_SIGNATURE_CHECKSUM
+                        )
+                        return null
+                    }
+        }
+
+        jsonNode.booleanOrNull(EXTRA_PROVISIONING_SKIP_ENCRYPTION)?.let { data.skipEncryption = it }
+        jsonNode.booleanOrNull(EXTRA_PROVISIONING_LEAVE_ALL_SYSTEM_APPS_ENABLED)?.let {
+            data.systemAppsEnabled = it
+        }
+        jsonNode.objectOrNull(EXTRA_PROVISIONING_ADMIN_EXTRAS_BUNDLE)?.let {
+            data.extrasBundle = jsonToPersistableBundle(it)
+        }
+
+        data.locale = jsonNode.textOrNull(EXTRA_PROVISIONING_LOCALE)
+
+        return data
+    }
+
+    private fun jsonToPersistableBundle(json: JSONObject): PersistableBundle =
+        PersistableBundle().apply {
+            json.keys().forEach { key ->
+                when (val value = json.get(key)) {
+                    is String -> putString(key, value)
+                    is Int -> putInt(key, value)
+                    is Long -> putLong(key, value)
+                    is Boolean -> putBoolean(key, value)
+                    is Double -> putDouble(key, value)
+                    // Recursively handle nested objects
+                    is JSONObject -> putPersistableBundle(key, jsonToPersistableBundle(value))
+                    // PersistableBundle supports only primitive arrays -> use String[]
+                    is JSONArray ->
+                        putStringArray(
+                            key,
+                            Array(value.length()) { value.opt(it)?.toString() ?: "" }
+                        )
+                }
+            }
+        }
+
+    companion object {
+
+        private fun JSONObject.textOrNull(name: String) = opt(name) as? String
+
+        private fun JSONObject.booleanOrNull(name: String) = opt(name) as? Boolean
+
+        private fun JSONObject.objectOrNull(name: String) = opt(name) as? JSONObject
+    }
+}
