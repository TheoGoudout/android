+    <string name="e_peak_refresh_rate_summary">Aktivieren Sie diese Option, um die Aktualisierungsrate von 60 auf %1$d Hz zu erhöhen</string>
 </resources>
\ No newline at end of file
diff --git a/res/values-es/e_strings.xml b/res/values-es/e_strings.xml
