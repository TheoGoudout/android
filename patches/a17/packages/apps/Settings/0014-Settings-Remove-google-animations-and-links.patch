 res/xml/smart_battery_detail.xml              |  5 -
 ...ionSettingsFooterPreferenceController.java | 12 ---
 5 files changed, 114 deletions(-)
 delete mode 100644 res/drawable/ic_enhanced_connectivity.xml
 delete mode 100644 res/raw/auto_awesome_battery_lottie.json

