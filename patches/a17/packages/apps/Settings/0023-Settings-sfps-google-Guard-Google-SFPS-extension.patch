From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kshitij Gupta <kshitijgm@gmail.com>
Date: Thu, 7 Nov 2024 10:58:00 +0100
Subject: [PATCH 23/32] Settings: sfps-google: Guard Google SFPS extension

(cherry picked from commit 511ec047283212c4dd33157d09f4b5772cccf5a2)
---
 res/values/e_config.xml                       | 20 +++++++++++++++++++
 .../FingerprintEnrollEnrolling.java           |  2 +-
 .../FingerprintFeatureProvider.java           |  2 +-
 .../FingerprintFeatureProviderImpl.java       |  4 ++--
 .../feature/SfpsEnrollmentFeatureImpl.java    |  9 ++++++++-
 5 files changed, 32 insertions(+), 5 deletions(-)
 create mode 100644 res/values/e_config.xml

diff --git a/res/values/e_config.xml b/res/values/e_config.xml
new file mode 100644
index 0000000000..2b8dabdbbc
--- /dev/null
+++ b/res/values/e_config.xml
@@ -0,0 +1,20 @@
+<?xml version="1.0" encoding="utf-8"?>
