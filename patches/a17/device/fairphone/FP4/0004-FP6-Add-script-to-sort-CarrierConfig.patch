+import sys
+import xml.etree.ElementTree as ET
+from xml.dom import minidom
+
+# 1. Global Fixed Overrides (Applied to ALL carrier_config blocks)
+FIXED_OVERRIDES = {
+    "hide_enhanced_4g_lte_bool": ("boolean", "false"),
+    "editable_wfc_mode_bool": ("boolean", "true"),
+    "config_update_service_status": ("boolean", "true"),
+    "editable_enhanced_4g_lte_bool": ("boolean", "true"),
+    "enhanced_4g_lte_on_by_default_bool": ("boolean", "true"),
+    "world_phone_bool": ("boolean", "false"),
+    "show_cdma_choices_bool": ("boolean", "false"),
+    "call_barring_visibility_bool": ("boolean", "true"),
+}
+
+# 2. Base Additions/Overrides (Only injected into the root <carrier_config> with no attributes)
+BASE_ADDITIONS = {
+    "csp_enabled_bool": ("boolean", "true"),
+}
+
+# 3. Targeted Carrier Overrides (Supports simple elements, strings, AND array lists)
+SPECIFIC_OVERRIDES = {
+}
+
+# Keep track of which specific array elements were modified by our override rules
+MODIFIED_ARRAY_NAMES = set()
+
+def sort_attributes(element):
+    """Sorts attributes of an element and all its sub-elements alphabetically."""
+    if element.attrib:
+        sorted_attrib = dict(sorted(element.attrib.items()))
+        element.attrib.clear()
+        element.attrib.update(sorted_attrib)
+    for child in element:
+        sort_attributes(child)
+
+def clean_text(text):
+    """Removes leading/trailing whitespaces and newlines from element text."""
+    if text:
+        text = text.strip()
+    return text if text else None
+
+def get_sort_key(child):
+    """Returns a strictly type-safe tuple key for sorting carrier_config elements."""
+    cid = child.get('cid', '')
+    mcc = child.get('mcc', '')
+    mnc = child.get('mnc', '')
+    
+    # Generic default block with no identifiers goes to the absolute top
+    if not cid and not mcc and not mnc:
+        return (-1, 0, "", 0, 0, "", "")
+        
+    if cid:
+        if cid.isdigit():
+            return (0, int(cid), "", 0, 0, "", "")
+        else:
+            return (1, 0, cid, 0, 0, "", "")
+    else:
+        mcc_int = int(mcc) if mcc.isdigit() else -1
+        mnc_int = int(mnc) if mnc.isdigit() else -1
+        return (2, 0, "", mcc_int, mnc_int, mcc, mnc)
+
+def build_or_update_element(existing_item, tag_type, name, data):
+    """Constructs or updates an XML Element node in-place."""
+    node = existing_item if existing_item is not None else ET.Element(tag_type, name=name)
+    node.tag = tag_type
+    
+    if isinstance(data, list):
+        node.clear()
+        node.tag = tag_type
+        node.set("name", name)
+        node.set("num", str(len(data)))
+        node.text = None
+        
+        MODIFIED_ARRAY_NAMES.add(name)
+        
+        for val in data:
+            item_elem = ET.Element("item")
+            item_elem.set("value", str(val))
+            node.append(item_elem)
+    else:
+        if tag_type == "string":
+            if "value" in node.attrib:
+                del node.attrib["value"]
+            if "num" in node.attrib:
+                del node.attrib["num"]
+            node.text = str(data)
+        else:
+            if "num" in node.attrib:
+                del node.attrib["num"]
+            node.text = None 
+            node.set("value", str(data))
+        
+    return node
+
+def inject_or_update_entries(config_node, modification_dict):
+    """Helper to insert or overwrite tags inside a given carrier_config element node."""
+    for name, (tag_type, data) in modification_dict.items():
+        existing_item = None
+        for item in config_node:
+            if item.get("name") == name:
+                existing_item = item
+                break
+        
+        if existing_item is not None:
+            build_or_update_element(existing_item, tag_type, name, data)
+        else:
+            new_node = build_or_update_element(None, tag_type, name, data)
+            config_node.append(new_node)
+
+def format_carrier_config_xml(input_file, output_file):
+    try:
+        MODIFIED_ARRAY_NAMES.clear()
+        
+        tree = ET.parse(input_file)
+        root = tree.getroot()
+        
+        # 1. Clean whitespace text strings
+        for elem in root.iter():
+            elem.text = clean_text(elem.text)
+            elem.tail = clean_text(elem.tail)
+
+        # 2. Apply Custom Targeted Rules & Global Configurations
+        for config in root:
+            if config.tag == "carrier_config":
+                cid = config.get('cid')
+                mcc = config.get('mcc')
+                mnc = config.get('mnc')
+                
+                if not cid and not mcc and not mnc:
+                    inject_or_update_entries(config, BASE_ADDITIONS)
+
+                if cid and f"cid:{cid}" in SPECIFIC_OVERRIDES:
+                    inject_or_update_entries(config, SPECIFIC_OVERRIDES[f"cid:{cid}"])
+                    
+                if mcc and f"mcc:{mcc}" in SPECIFIC_OVERRIDES:
+                    inject_or_update_entries(config, SPECIFIC_OVERRIDES[f"mcc:{mcc}"])
+                    
+                if mcc and mnc and f"mcc_mnc:{mcc}_{mnc}" in SPECIFIC_OVERRIDES:
+                    inject_or_update_entries(config, SPECIFIC_OVERRIDES[f"mcc_mnc:{mcc}_{mnc}"])
+
+                for item in list(config):
+                    name = item.get("name")
+                    if name in FIXED_OVERRIDES:
+                        expected_tag, forced_value = FIXED_OVERRIDES[name]
+                        if item.tag == expected_tag:
+                            item.set("value", forced_value)
+
+        # 3. Sort the root carrier_config tags sequentially
+        root[:] = sorted(root, key=get_sort_key)
+
+        # 4. Sort inner items alphabetically inside each configuration block
+        for config in root:
+            config[:] = sorted(config, key=lambda item: item.get('name', ''))
+            
+            # Conditionally sort inner array elements
+            for item_list in config:
+                if len(item_list) > 0 and item_list.tag in ('string-array', 'int-array'):
+                    array_name = item_list.get('name')
+                    
+                    if array_name in MODIFIED_ARRAY_NAMES:
+                        def extract_item_sort_value(item):
+                            if item.get('value') is not None:
+                                return item.get('value')
+                            return item.text if item.text else ''
+                        
+                        item_list[:] = sorted(item_list, key=extract_item_sort_value)
+
+        # 5. Alphabetize block attribute layouts
+        sort_attributes(root)
+
+        # 6. Toprettyxml Clean Output Pipeline
+        xml_string = ET.tostring(root, encoding='utf-8')
+        parsed_xml = minidom.parseString(xml_string)
+        
+        # We explicitly omit the minidom declaration to force our own structured header structure string safely
+        pretty_xml = parsed_xml.toprettyxml(indent="    ")
+        cleaned_lines = [line for line in pretty_xml.splitlines() if line.strip() and not line.strip().startswith("<?xml")]
+        
+        # Overwrite the output file cleanly with the updated full encoding string header format layout
+        with open(output_file, "w", encoding="utf-8") as f:
+            f.write('<?xml version="1.0" encoding="utf-8"?>\n')
+            f.write("\n".join(cleaned_lines) + "\n")
+            
+        print(f"Successfully processed and saved to {output_file}")
+
+    except Exception as e:
+        print(f"Error processing XML: {e}", file=sys.stderr)
+
+if __name__ == "__main__":
+    if len(sys.argv) < 3:
+        print("Usage: python normalize_and_format.py <input_file.xml> <output_file.xml>")
+        sys.exit(1)
+        
+    input_path = sys.argv[1]
+    output_path = sys.argv[2]
+    format_carrier_config_xml(input_path, output_path)
